{
  "manifest_version": 3,
  "name": "Walmart Smart Filter",
  "version": "1.5.0",
  "description": "Instantly filter Walmart search to Walmart Direct only. Highlights Clearance, Rollback & Reduced Price deals with colored borders. Shows live deal count on the icon.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["https://www.walmart.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.walmart.com/*"],
      "js": ["detector.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Walmart Smart Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-filter": {
      "suggested_key": {
        "default": "Ctrl+Shift+W",
        "mac": "Command+Shift+W"
      },
      "description": "Toggle Walmart Direct filter on/off"
    }
  }
}
